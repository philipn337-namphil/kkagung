# Copy to .env locally. Never put real credentials in this example.
# Names are a proposed contract; application code must explicitly load them.
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
SERVICE_TIMEZONE=Asia/Seoul
DAILY_RESET_HOUR=8

# Private Cloud DB endpoint. Use a least-privilege application account.
DB_HOST=
DB_PORT=3306
DB_NAME=kkagung
DB_USER=kkagung_app
DB_PASSWORD=change_me
DATABASE_URL=mysql://kkagung_app:change_me@localhost:3306/kkagung
DB_TLS_ENABLED=true

# No default signing key: application must refuse to start if missing in production.
JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=kkagung-api
AUTH_JWT_AUDIENCE=kkagung-client
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Comma-separated exact HTTPS origins in production. Do not use wildcard credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_ALLOWED_IP_CIDRS=

# Separate buckets; originals must never allow anonymous reads.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_PRIVATE=kkagung-original-private
OBJECT_STORAGE_BUCKET_PUBLIC=kkagung-profile-public
ORIGINAL_IMAGE_PREFIX=originals/
AI_IMAGE_PREFIX=profiles/ai/
BLURRED_IMAGE_PREFIX=profiles/blurred/
ORIGINAL_IMAGE_URL_TTL_SECONDS=60
IMAGE_UPLOAD_MAX_BYTES=10485760
IMAGE_UPLOAD_MAX_PIXELS=20000000
IMAGE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
PROFILE_IMAGE_MAX_COUNT=3

# Server-side only. Set limits after provider selection.
AI_IMAGE_API_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_REQUEST_TIMEOUT_SECONDS=30
AI_IMAGE_MAX_RETRIES=2
AI_IMAGE_DAILY_REQUEST_LIMIT=50

# Verify provider results on the server; reject unverifiable results.
ADULT_VERIFICATION_PROVIDER=
ADULT_VERIFICATION_API_KEY=

# Do not set admin passwords, private keys or credentials in images/init scripts.
